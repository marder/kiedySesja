# Ścieżka do bazy danych SQLite (nowa baza)
DB_PATH=./meetings.db
PORT=3001
HOST=0.0.0.0

# Konfiguracja ntfy.sh dla Miasta i Powiatu Turek
NTFY_ENABLED=true
NTFY_URL=https://ntfy.sh/kiedy-sesje-turek

# E-mail w tym projekcie jest wyłączony
SMTP_ENABLED=false

# Timeout żądań HTTP w ms
HTTP_TIMEOUT_MS=15000
